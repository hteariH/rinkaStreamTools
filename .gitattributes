# Батник обязан быть в CRLF: с LF cmd.exe разваливает блоки if (...) и
# начинает исполнять куски текста как команды.
*.bat text eol=crlf
*.sh  text eol=lf
# Скрипт опроса медиасессии PowerShell читает как ANSI, если в файле нет BOM, —
# кириллица в комментариях тогда превращается в мусор и ломает разбор. BOM в файле
# есть, и трогать его нельзя.
*.ps1 text eol=crlf
